{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "eslint.validate": ["javascript"],
  "stylelint.validate": ["css"],
  "files.associations": {
    "*.css": "css"
  }
}
